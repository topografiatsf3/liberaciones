rules_version = '2';

// Reglas de seguridad de Liberaciones TSF3.
// - Solo entran cuentas de Google aprobadas (colección "usuarios", el id es el correo).
// - El administrador principal entra directo y aprueba a los demás.
// - Quien entra por primera vez deja una "solicitud" y espera aprobación.
// - Roles: topografo y operario (registran y pueden agregar tipos y elementos nuevos), gabinete (genera protocolos, cambia estados y rechaza),
//   jefe (ve todo, tiene los mismos ajustes que el administrador, procesa las aspas y se da por enterado de los levantamientos), admin (todo).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'brandonkluivertvillegasfranco@gmail.com'; }
    function perfilPath() { return /databases/$(database)/documents/usuarios/$(email()); }
    function hasRol(roles) {
      return signedIn() && exists(perfilPath())
        && get(perfilPath()).data.activo == true
        && get(perfilPath()).data.rol in roles;
    }
    function isAdmin() { return isOwner() || hasRol(['admin']); }
    function isGab()   { return isOwner() || hasRol(['gabinete', 'admin']); }
    function writer()  { return isOwner() || hasRol(['topografo', 'operario', 'gabinete', 'admin']); }
    // Ajustes: administrador y jefe de área tienen los mismos permisos
    function isConf()  { return isAdmin() || hasRol(['jefe']); }
    // Cambios que solo mandan a la papelera o restauran
    function soloPapelera() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['borrado', 'borradoPor', 'borradoNombre', 'borradoEn']); }
    // Depuración de fotos: solo cambia la lista de archivos del registro
    function soloArchivos() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archivos']); }
    // Aspas para vuelo de dron: marcar como procesado o devolver (administrador y jefe de área)
    function soloProcesado() { return resource.data.actividad == 'ASP' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['procesado', 'procesadoPor', 'procesadoNombre', 'procesadoEn']); }
    // Levantamientos (sin código): gabinete, jefe de área y administrador marcan «Enterado» o lo quitan
    function soloVisto() { return resource.data.estado == 'NA' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto', 'vistoPor', 'vistoNombre', 'vistoEn']); }
    // Unir un tipo o elemento repetido: solo cambia a qué tipo y elemento pertenece el registro
    function soloTipo() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipoId', 'elementoId', 'editadoEn', 'editadoPor']); }
    // Desde campo solo se puede AGREGAR un nombre al final de la lista de tipos o elementos (no cambiar ni borrar los que hay)
    function soloAgrega() {
      let n = resource.data.items.size();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'editadoEn', 'editadoPor'])
        && request.resource.data.items.size() == n + 1
        && request.resource.data.items.hasAll(resource.data.items)
        && request.resource.data.items[n].creadoPor == email();
    }
    // Gabinete no edita lo que viene de campo: acepta, observa, rechaza, entrega y pone o corrige la capa
    function sinTocarCampo() { return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
      'actividad', 'fechaCampo', 'topografoId', 'equipo', 'estructuraId', 'subestructuraId', 'elementoId', 'tipoId',
      'pkInicio', 'pkFin', 'cota', 'area', 'descripcion', 'observaciones', 'linksCsv', 'linksFotos', 'archivos',
      'creadoPor', 'creadoEn', 'origen']); }
    function tocaPapelera() { return request.resource.data.diff(resource.data).affectedKeys().hasAny(['borrado']); }
    // Entregar a Calidad exige el XML de la superficie (con el mismo código; la app lo revisa al subirlo)
    function entregaConXml() {
      return request.resource.data.get('estado', '') != 'EC' || resource.data.get('estado', '') == 'EC'
        || (request.resource.data.get('xmlEntrega', []) is list && request.resource.data.get('xmlEntrega', []).size() > 0);
    }
    // Código SKT-TOP único: una vez puesto, el número (y los protocolos con sus números) no cambia.
    // Un número nuevo solo vale si en la misma transacción el correlativo sube y el número termina en «último + 1»
    // (así nadie puede escribir a mano un código ya usado).
    function contadorPath() { return /databases/$(database)/documents/contadores/skt; }
    function codigoNuevo(n) {
      return n is string && exists(contadorPath()) && existsAfter(contadorPath())
        && getAfter(contadorPath()).data.ultimo > get(contadorPath()).data.ultimo
        && n.matches('.*[^0-9]0*' + string(get(contadorPath()).data.ultimo + 1));
    }
    function numeroFijo() {
      let antes = resource.data.get('numero', '');
      let ahora = request.resource.data.get('numero', '');
      return (ahora == antes && request.resource.data.get('protocolos', null) == resource.data.get('protocolos', null))
        || (antes == '' && codigoNuevo(ahora));
    }
    function member()  { return isOwner() || hasRol(['topografo', 'operario', 'gabinete', 'jefe', 'admin']); }

    // Cuentas con acceso (id = correo en minúsculas)
    // El jefe de área administra cuentas, pero no la suya (no se sube de rol ni se desactiva)
    // ni la de un administrador, y no puede crear administradores.
    match /usuarios/{correo} {
      allow read: if signedIn() && (email() == correo || member());
      allow create, update: if isConf()
        && (correo != 'brandonkluivertvillegasfranco@gmail.com' || isOwner())
        && (isAdmin() || (correo != email()
              && request.resource.data.get('rol', '') != 'admin'
              && (resource == null || resource.data.get('rol', '') != 'admin')));
      allow delete: if isConf()
        && correo != 'brandonkluivertvillegasfranco@gmail.com'
        && (isAdmin() || (correo != email() && resource.data.get('rol', '') != 'admin'));
    }

    // Pedidos de acceso de cuentas nuevas
    match /solicitudes/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isConf());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == email();
      allow delete: if signedIn() && (request.auth.uid == uid || isConf());
    }

    // Listas editables, configuración y correlativo SKT-TOP
    match /listas/{id}     {
      allow read: if member();
      allow write: if isConf() || (id in ['tipos', 'elementos'] && writer() && soloAgrega());
    }
    match /config/{id}     { allow read: if member(); allow write: if isConf(); }
    // El correlativo solo sube (nunca se baja para reutilizar códigos); bajarlo o borrarlo, solo el administrador
    match /contadores/{id} {
      allow read: if member();
      allow create: if (isGab() || isConf()) && request.resource.data.ultimo is int;
      allow update: if isAdmin() || ((isGab() || isConf())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'editadoPor', 'editadoEn'])
        && request.resource.data.ultimo is int && request.resource.data.ultimo > resource.data.ultimo);
      allow delete: if isAdmin();
    }
    match /ejes/{id}       { allow read: if member(); allow write: if isGab() || isConf(); }
    match /capas/{id}      { allow read: if member(); allow write: if isConf(); }
    // Resumen por frente para el panel (se actualiza junto con cada registro).
    // Campo solo agrega o actualiza sus filas: no puede vaciarlo, borrarlo ni llenarlo de golpe.
    match /resumen/{id} {
      allow read: if member();
      allow create: if isGab() || isConf() || (writer()
        && request.resource.data.keys().hasOnly(['r']) && request.resource.data.r.size() <= 200);
      allow update: if isGab() || isConf() || (writer()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && request.resource.data.r.size() >= resource.data.r.size() - 1
        && request.resource.data.r.size() <= resource.data.r.size() + 200);
      allow delete: if isConf();
    }

    // Modelo 2D de gabinete: secciones de diseño del frente y superficie de cada liberación
    match /secciones/{id}      { allow read: if isGab() || isConf(); allow write: if isGab() || isConf(); }
    match /superficies/{id}    { allow read: if isGab() || isConf(); allow write: if isGab() || isConf(); }
    match /superficiesRes/{id} { allow read: if isGab() || isConf(); allow write: if isGab() || isConf(); }
    // Base (100 %) de cada capa para el avance en planta real
    match /bases/{id}          { allow read: if isGab() || isConf(); allow write: if isGab() || isConf(); }

    // Liberaciones y levantamientos
    match /liberaciones/{id} {
      allow read: if member();

      // En campo se crea siempre sin número y en estado PT (o NA si no es liberación).
      // Administrador y jefe pueden crear sin esa condición (importación del histórico).
      allow create: if isConf() || (writer()
        && request.resource.data.creadoPor == email()
        && request.resource.data.estado in ['PT', 'NA']
        && request.resource.data.numero == ''
        && request.resource.data.origen == 'app');

      // El administrador edita todo. Gabinete cambia estados, códigos y la capa, sin tocar lo registrado
      // en campo, y a la papelera solo manda lo que aún no tiene código. Jefe: el histórico importado y la papelera. El topógrafo solo lo suyo mientras
      // está pendiente u observado (sin tocar número, entrega ni autoría) y puede mandarlo a la
      // papelera si aún no tiene código. Jefe también puede depurar fotos (solo la lista de archivos)
      // marcar como procesados los levantamientos de aspas, marcar «Enterado» en los levantamientos y unir tipos o elementos repetidos.
      allow update: if isAdmin()
        || (hasRol(['gabinete']) && sinTocarCampo() && numeroFijo() && entregaConXml() && (!tocaPapelera() || resource.data.get('numero', '') == ''))
        || (isConf() && (request.resource.data.origen == 'excel' || soloPapelera() || soloArchivos() || soloProcesado() || soloVisto() || soloTipo()))
        || (writer()
          && resource.data.creadoPor == email()
          && resource.data.get('numero', '') == ''
          && resource.data.estado in ['PT', 'OB', 'NA']
          && soloPapelera() && request.resource.data.borrado == true)
        || (writer()
          && resource.data.creadoPor == email()
          && resource.data.estado in ['PT', 'OB', 'NA']
          && request.resource.data.estado in ['PT', 'NA']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'numero', 'protocolos', 'nombreLiberacion', 'generadoPor', 'fechaLiberacion', 'fechaEntrega',
               'numeroCargo', 'carpeta', 'xmlEntrega', 'notaObservacion', 'notaRechazo', 'motivoEdicion', 'creadoPor', 'creadoEn', 'origen',
               'borrado', 'borradoPor', 'borradoNombre', 'borradoEn',
               'procesado', 'procesadoPor', 'procesadoNombre', 'procesadoEn',
               'visto', 'vistoPor', 'vistoNombre', 'vistoEn']));

      // Borrar para siempre (vaciar la papelera): administrador y jefe
      allow delete: if isConf();
    }

    // Archivos subidos (CSV como texto y fotos comprimidas), máximo 1 MB cada uno
    match /archivos/{id} {
      allow read: if member();
      allow create: if writer()
        && request.resource.data.creadoPor == email()
        && request.resource.data.tipo in ['csv', 'foto']
        && request.resource.data.datos is string
        && request.resource.data.datos.size() <= 1000000;
      allow update: if false;
      allow delete: if isGab() || isConf() || (writer() && resource.data.creadoPor == email());
    }

    // Historial de cambios: se agrega, nunca se modifica
    match /historial/{id} {
      allow read: if member();
      allow create: if (writer() || isConf()) && request.resource.data.usuario == email();
      allow update, delete: if false;
    }
  }
}
